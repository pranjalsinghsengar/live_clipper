# =========================================================================
# clips_pipeline configuration.
# Copy this file to ".env" and fill in the values you actually use.
# Everything not filled in is silently skipped (e.g. if you only post to
# Instagram, leave the TikTok_* lines blank).
# =========================================================================

# --- Paths ---
# Where to keep everything. Defaults to ~/clips_pipeline_data if blank.
PIPELINE_DATA_DIR=

# --- SQLite DB ---
# Defaults to state.db inside PIPELINE_DATA_DIR.
DB_PATH=

# --- Antigravity / Gemma 4 LiteRT (clip curation) ---
# Path to the .litertlm model file. Follow the Antigravity docs to import it:
#   litert-lm import \
#     --from-huggingface-repo=litert-community/gemma-4-26B-A4B-it-litert-lm \
#     gemma-4-26B-A4B-it-gpu.litertlm \
#     gemma4-26b
# The file ends up at ~/.litert-lm/models/gemma4-26b/model.litertlm
ANTIGRAVITY_MODEL_PATH=
# Hardware backend: "gpu" (Apple Silicon Metal) or "npu".
ANTIGRAVITY_BACKEND=gpu
# Max number of clips the curator may pick per video.
MAX_CLIPS_PER_VIDEO=10
# Clip length range in seconds.
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=60

# --- ffmpeg ---
# Path to ffmpeg binary. Leave blank to use whatever is on $PATH.
FFMPEG_PATH=
# Caption style. "karaoke" highlights the current word; "block" shows a phrase.
CAPTION_STYLE=karaoke
# Vertical output dimensions.
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# --- Instagram (Meta Graph API) ---
# Create a Meta app at https://developers.facebook.com/, enable Instagram Graph
# API, link it to an IG Business account. Then generate a long-lived access
# token. You also need the IG user id (numeric).
IG_ACCESS_TOKEN=
IG_USER_ID=
# Optional: a public base URL the IG API can fetch the video from. If left
# blank, the pipeline runs a tiny local HTTP server during the upload step
# and exposes it via the host's public IP. That works on a home network but
# not behind CGNAT. For 100% reliability use a public URL (e.g. a Cloudflare
# Tunnel pointing at the local file server).
PUBLIC_VIDEO_BASE_URL=

# --- TikTok (Content Posting API) ---
# Register an app at https://developers.tiktok.com/, enable "Upload and post
# videos" scope. Use the direct upload flow (we POST the file to TikTok, no
# public URL needed).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- YouTube Shorts (Data API v3, OAuth 2.0) ---
# No static credentials in .env - we use OAuth. One-time setup:
#   1. https://console.cloud.google.com/ -> create project
#   2. Enable "YouTube Data API v3"
#   3. Create OAuth 2.0 Client ID (Application type: Desktop app)
#   4. Download the JSON, save it as youtube_client_secret.json in your
#      PIPELINE_DATA_DIR (defaults to ~/clips_pipeline_data/).
#   5. Run: python cli.py youtube-auth
#      This opens a browser, you authorize, the token is cached at
#      youtube_token.json. Subsequent runs refresh it automatically.
# Set YOUTUBE_ENABLED=0 to skip YouTube entirely (e.g. while setting it up).
YOUTUBE_ENABLED=1
# Auto-delete local .mp4 and .ass clip files after successful upload to YouTube
DELETE_CLIPS_AFTER_UPLOAD=1

# --- Live mode ---
# How often to poll each channel for "is live?". 120s = 2 minutes.
LIVE_POLL_INTERVAL_SECONDS=120
# Whisper window: every N seconds we transcribe the last N seconds of audio.
# Lower = faster clip turnaround, more CPU. 60s is a good balance.
LIVE_TRANSCRIBE_WINDOW_SECONDS=60
# How often the curator runs Antigravity on the rolling transcript (seconds).
LIVE_CURATE_INTERVAL_SECONDS=300
# streamlink quality. "best" = source quality (6Mbps+ on Twitch). "720p60"
# is a sane default that keeps files reasonable (~2GB/hr).
LIVE_STREAM_QUALITY=720p60
# Delete source recordings N hours after the stream ended.
LIVE_CLEANUP_HOURS=24
# Max parallel recordings. 0 = no limit. Set to 3-5 if you have many channels
# and limited disk/CPU.
LIVE_MAX_PARALLEL=0

# --- Schedule (used by launchd plists, not this .env) ---
# Weekly clip run: every Sunday 03:00 Asia/Calcutta
# Post slot 1: every day 15:00 Asia/Calcutta
# Post slot 2: every day 20:00 Asia/Calcutta

# --- Logging ---
LOG_LEVEL=INFO
